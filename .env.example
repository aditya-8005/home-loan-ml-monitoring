# MLflow Tracking Configuration
# For local Python execution, use http://localhost:5000
# (Note: Docker Compose automatically configures container-to-container communication as http://mlflow:5000)
MLFLOW_TRACKING_URI=http://localhost:5000

# Registered Model Configuration
MODEL_NAME=HomeLoanClassifier
MODEL_ALIAS=champion

# Container / Host Port Mappings (Docker Compose)
MLFLOW_PORT=5000
API_PORT=8000
DASHBOARD_PORT=8501
